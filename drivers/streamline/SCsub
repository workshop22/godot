#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

# NVIDIA Streamline (DLSS), Vulkan only: the interposer and its plugins load at runtime (LoadLibrary), so nothing links.
env_streamline = env.Clone()
env_streamline.Prepend(CPPPATH=["#thirdparty/streamline/include", "#thirdparty/vulkan", "#thirdparty/vulkan/include"])

driver_obj = []
env_streamline.add_source_files(driver_obj, "*.cpp")
env.drivers_sources += driver_obj
